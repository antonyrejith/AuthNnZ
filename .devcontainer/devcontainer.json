// Development container for Portun. Everything is pinned (decision D-15):
// the image by tag and digest, the feature by digest (docker-in-docker
// 4.1.3), and the developer tools by the tools modules (make tools).
{
  "name": "portun",
  "image": "golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d",
  "features": {
    // docker-in-docker 4.1.3: integration tests run PostgreSQL, Valkey and NATS in Docker.
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {
      "moby": false
    }
  },
  "containerEnv": {
    "GOTOOLCHAIN": "local",
    "GOFLAGS": "-mod=readonly"
  },
  "postCreateCommand": "make tools hooks"
}
